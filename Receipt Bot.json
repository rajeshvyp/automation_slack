    {
      "parameters": {
        "jsCode": "\nreturn $input.all().map(item => {\n  // Get the AI response and the recipe name from the previous node.\n  const data = item.json;\n  const recipe = String($('Receipe').first().json.receipe || 'your recipe').trim();\n  const title = recipe.charAt(0).toUpperCase() + recipe.slice(1);\n\n  // Convert escaped line breaks into real line breaks.\n  const raw = String(data.text || '')\n    .replace(/\\\\n/g, '\\n')\n    .replace(/\\r\\n/g, '\\n')\n    .replace(/\\r/g, '\\n')\n    .replace(/\\n{3,}/g, '\\n\\n')\n    .trim();\n\n  // Convert Markdown bold syntax to Slack's supported bold syntax.\n  // Preserve ingredient bullets, numbered steps, and section headings.\n  const recipeContent = raw\n    .replace(/\\*\\*(.*?)\\*\\*/g, '*$1*')\n    .replace(/^\\s*[-•]\\s*/gm, '• ')\n    .trim();\n\n  // Create the final friendly Slack message.\n  const message = [\n    '👋 Hello there!',\n    '',\n    recipeContent || 'Sorry, I couldn’t prepare this recipe. Please try another recipe name.',\n    '',\n    '👨‍🍳 *Happy cooking!*',    \n  ].join('\\n');\n\n  return {\n    json: {\n      ...data,\n      text: message\n    }\n  };\n});\n"
      },
